{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sagentic-university-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "UniversityAgent", "class_name": "UniversityAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UniversityAgent"] }
  ],
  "observability": { "enabled": true }
}
